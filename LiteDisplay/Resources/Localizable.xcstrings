        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not create the virtual display (%@)."
          }
        }
      }
    },
    "Não foi possível gravar a preferência de suavização.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not write the font smoothing preference."
          }
        }
      }
    },
    "Não foi possível salvar: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save: %@"
          }
        }
      }
    },
    "O LiteDisplay pode instalar um perfil em /Library/Displays com resoluções HiDPI de %@ para baixo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteDisplay can install a profile in /Library/Displays with HiDPI resolutions from %@ down."
          }
        }
      }
    },
    "O LiteDisplay precisa de permissão de administrador para instalar o perfil HiDPI do monitor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteDisplay needs administrator permission to install the display’s HiDPI profile."
          }
        }
      }
    },
    "O identificador do monitor é inválido.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The display identifier is invalid."
          }
        }
      }
    },
    "O macOS desenha na resolução do painel, sem suavização HiDPI. Texto serrilhado em monitores Full HD.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS renders at the panel resolution without HiDPI smoothing. Jagged text on Full HD displays."
          }
        }
      }
    },
    "O macOS não oferece modos HiDPI para este painel.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS offers no HiDPI modes for this panel."
          }
        }
      }
    },
    "O macOS recusou a mudança de modo (%@, código %d).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS refused the mode change (%1$@, code %2$d)."
