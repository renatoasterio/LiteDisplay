    "Ative o LiteDisplay em Ajustes do Sistema › Geral › Itens de Login.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable LiteDisplay in System Settings › General › Login Items."
