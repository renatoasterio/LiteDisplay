      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New profile"
          }
        }
      }
    },
    "Não foi possível alterar o item de login: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not change the login item: %@"
          }
        }
