          "stringUnit": {
            "state": "translated",
            "value": "Sharpness"
          }
        }
      }
    },
    "No modo padrão o monitor usa a resolução nativa. Escolha HiDPI nativo ou Tela virtual para texto nítido.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In standard mode the display uses its native resolution. Choose Native HiDPI or Virtual display for sharp text."
          }
        }
      }
    },
