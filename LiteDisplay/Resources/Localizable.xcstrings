            "state": "translated",
            "value": "More space"
          }
        }
      }
    },
    "Mantém a taxa de atualização. Pede a senha de administrador e reconectar o monitor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the refresh rate. Requires the administrator password and reconnecting the display."
          }
        }
      }
    },
    "Mantém a tela virtual e a restauração automática disponíveis desde o início da sessão.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the virtual display and automatic restore available from the start of the session."
          }
        }
      }
    },
    "Marque “Aplicar ao conectar” para o LiteDisplay restaurar tudo sozinho.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check “Apply on connect” so LiteDisplay restores everything by itself."
          }
        }
      }
    },
