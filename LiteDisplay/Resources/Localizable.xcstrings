          "stringUnit": {
            "state": "translated",
            "value": "Filter modes"
          }
        }
      }
    },
    "Guarde combinações de nitidez, tamanho e taxa e aplique com um clique, aqui ou pelo menu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save combinations of sharpness, size and rate and apply them in one click, here or from the menu."
